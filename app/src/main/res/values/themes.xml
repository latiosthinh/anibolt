<resources>
    <style name="AppTheme" parent="Theme.Leanback">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/tv_accent</item>
        <item name="android:windowBackground">@color/tv_background</item>
        <!-- qfilm section headings: semibold 2xl, near-white. -->
        <item name="rowHeaderStyle">@style/AniRowHeader</item>
        <item name="android:windowAnimationStyle">@style/RouteAnimation</item>
    </style>
    <!-- Screen changes: quick fade with a slight depth change instead of the default slide. -->
    <style name="RouteAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/route_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/route_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/route_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/route_close_exit</item>
    </style>
    <style name="AniRowHeader" parent="Widget.Leanback.Row.Header">
        <item name="android:textColor">@color/tv_text</item>
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="TvButton">
        <item name="android:background">@drawable/tile_bg</item>
        <item name="android:textColor">@color/tv_text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:focusable">true</item>
    </style>
    <!-- qfilm: bold uppercase section title with a zinc divider underneath. -->
    <style name="SectionTitle">
        <item name="android:textColor">@color/tv_text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
    </style>
    <!-- Round icon buttons on the player bar. -->
    <style name="PlayerButton">
        <item name="android:layout_width">46dp</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">@drawable/player_button_bg</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="HintText">
        <item name="android:textColor">@color/tv_muted</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
