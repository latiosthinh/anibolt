<?xml version="1.0" encoding="utf-8"?>
<!-- qfilm movie page: poster column + info (title, badge, meta, TỔNG QUAN, info table), then XEM PHIM. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:paddingStart="48dp" android:paddingEnd="48dp" android:paddingTop="24dp" android:paddingBottom="16dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <ImageView android:id="@+id/detail_poster" android:layout_width="176dp" android:layout_height="264dp" android:scaleType="centerCrop"
            android:src="@drawable/poster_placeholder" android:background="@drawable/poster_frame" android:alpha="0.85" android:importantForAccessibility="no" />

        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="32dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/detail_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/details_fallback_title"
                    android:textColor="@color/tv_text" android:textSize="28sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/detail_quality" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp"
                    android:background="@drawable/chip_bg" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="4dp" android:paddingBottom="4dp"
                    android:textColor="@color/tv_text" android:textSize="14sp" android:textStyle="bold" android:textAllCaps="true" android:maxLines="1" android:visibility="gone" />
            </LinearLayout>
            <TextView android:id="@+id/detail_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:textColor="@color/tv_muted" android:textSize="16sp" android:maxLines="1" android:ellipsize="end" android:visibility="gone" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/section_overview" style="@style/SectionTitle" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="6dp" android:background="@color/tv_divider" />
            <TextView android:id="@+id/detail_descr" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:textColor="@color/tv_text" android:textSize="16sp" android:lineSpacingExtra="2dp" android:maxLines="2" android:ellipsize="end" />
            <TableLayout android:id="@+id/detail_table" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:stretchColumns="1" android:shrinkColumns="1" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal">
                <Button android:id="@+id/resume_episode" style="@style/TvButton" android:layout_width="wrap_content" android:layout_height="52dp" android:layout_marginEnd="12dp"
                    android:drawableStart="@drawable/ic_play_circle" android:drawablePadding="10dp" android:visibility="gone" android:nextFocusRight="@id/watch_latest" android:nextFocusDown="@id/episode_grid" />
                <Button android:id="@+id/watch_latest" style="@style/TvButton" android:layout_width="wrap_content" android:layout_height="52dp" android:text="@string/action_loading"
                    android:drawableStart="@drawable/ic_play_circle" android:drawablePadding="10dp" android:enabled="false" android:nextFocusRight="@id/episode_order" android:nextFocusDown="@id/episode_grid" />
                <Button android:id="@+id/detail_retry" style="@style/TvButton" android:layout_width="wrap_content" android:layout_height="52dp" android:text="@string/action_retry" android:layout_marginStart="12dp" android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="18dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/section_watch" style="@style/SectionTitle" />
        <ImageView xmlns:tools="http://schemas.android.com/tools" tools:ignore="UseAppTint" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginStart="12dp" android:src="@drawable/ic_camera" android:tint="@color/tv_accent_amber" android:importantForAccessibility="no" />
        <TextView android:id="@+id/ep_count" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="16dp"
            android:text="@string/episodes_loading" android:textColor="@color/tv_muted" android:textSize="16sp" android:accessibilityLiveRegion="polite" />
        <Button android:id="@+id/episode_order" style="@style/TvButton" android:layout_width="wrap_content" android:layout_height="44dp" android:minHeight="44dp" android:textSize="16sp"
            android:text="@string/order_newest" android:nextFocusUp="@id/watch_latest" android:nextFocusLeft="@id/watch_latest" android:nextFocusDown="@id/episode_grid" android:visibility="gone" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="8dp" android:background="@color/tv_divider" />
    <!-- Episode ranges (1–10, 11–20, …) for long series; focusing a range shows its episodes. -->
    <com.animetv.ui.SelectedFocusRecyclerView android:id="@+id/episode_pages" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:clipToPadding="false" android:paddingStart="5dp" android:paddingEnd="5dp" android:overScrollMode="never" android:visibility="gone" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/episode_grid" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:clipToPadding="false" android:paddingTop="8dp" android:paddingBottom="8dp" android:nextFocusUp="@id/watch_latest" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/details_hint" style="@style/HintText" />
</LinearLayout>
