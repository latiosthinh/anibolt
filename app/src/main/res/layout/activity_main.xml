<?xml version="1.0" encoding="utf-8"?>
<!-- qfilm layout: sticky zinc sidebar + content. On TV the rail collapses to icons until it has focus. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:baselineAligned="false">

    <include layout="@layout/nav_rail" />

    <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
        <androidx.fragment.app.FragmentContainerView android:id="@+id/rows_fragment" android:name="androidx.leanback.app.RowsSupportFragment"
            android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="16dp" android:layout_marginBottom="36dp" />
        <TextView android:layout_width="match_parent" android:layout_height="36dp" android:layout_gravity="bottom" android:paddingStart="48dp" android:paddingEnd="48dp"
            android:gravity="center_vertical" android:text="@string/home_hint" style="@style/HintText" />
    </FrameLayout>
</LinearLayout>
