<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="60dp" android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingStart="28dp" android:paddingEnd="16dp" android:focusable="true" android:background="@drawable/rail_item_bg">
    <ImageView xmlns:tools="http://schemas.android.com/tools" tools:ignore="UseAppTint" android:id="@+id/rail_icon" android:layout_width="24dp" android:layout_height="24dp" android:tint="@color/rail_text" android:duplicateParentState="true" android:importantForAccessibility="no" />
    <TextView android:id="@+id/rail_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="18dp"
        android:textColor="@color/rail_text" android:textSize="18sp" android:maxLines="1" android:duplicateParentState="true" android:visibility="gone" />
</LinearLayout>
