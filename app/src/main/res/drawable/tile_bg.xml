<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- qfilm: zinc-900 controls that turn solid orange when chosen. -->
    <item android:state_enabled="false"><shape><solid android:color="#111113" /><corners android:radius="8dp" /></shape></item>
    <item android:state_focused="true"><shape><solid android:color="@color/tv_accent" /><corners android:radius="8dp" /><stroke android:width="2dp" android:color="@color/tv_text" /></shape></item>
    <item android:state_pressed="true"><shape><solid android:color="@color/tv_accent" /><corners android:radius="8dp" /></shape></item>
    <item><shape><solid android:color="@color/tv_surface" /><corners android:radius="8dp" /><stroke android:width="1dp" android:color="@color/tv_border" /></shape></item>
</selector>
