<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Text fields keep a dark fill when focused (readable typing) and gain the orange ring. -->
    <item android:state_focused="true"><shape><solid android:color="@color/tv_surface" /><corners android:radius="8dp" /><stroke android:width="3dp" android:color="@color/tv_accent" /></shape></item>
    <item><shape><solid android:color="@color/tv_surface" /><corners android:radius="8dp" /><stroke android:width="1dp" android:color="@color/tv_border" /></shape></item>
</selector>
