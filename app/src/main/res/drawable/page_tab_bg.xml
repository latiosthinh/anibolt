<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Episode range tabs: solid orange when focused (qfilm button), orange outline for the range on screen. -->
    <item android:state_focused="true"><shape><solid android:color="@color/tv_accent" /><corners android:radius="6dp" /></shape></item>
    <item android:state_selected="true"><shape><solid android:color="@color/tv_surface" /><corners android:radius="6dp" /><stroke android:width="2dp" android:color="@color/tv_accent" /></shape></item>
    <item><shape><solid android:color="@color/tv_surface" /><corners android:radius="6dp" /><stroke android:width="1dp" android:color="@color/tv_border" /></shape></item>
</selector>
